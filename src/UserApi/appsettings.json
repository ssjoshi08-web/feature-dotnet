{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "UserApi": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Application": {
    "Name": "UserApi",
    "Version": "1.0.0",
    "Environment": "Production"
  },
  "Swagger": {
    "Enabled": true,
    "Title": "UserApi",
    "Version": "v1",
    "Description": "REST API exposing GET /api/users and GET /health. Backed by an in-memory user repository.",
    "RoutePrefix": "swagger"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080"
      }
    }
  }
}
